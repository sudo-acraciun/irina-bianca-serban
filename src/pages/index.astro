---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EntryText from '../components/EntryText.astro';
import portrait from '../assets/irina-bianca-serban.jpg';
import {
  SITE,
  TODO,
  INTERESTS,
  EXPERIENCE,
  PROJECT_GROUPS,
  SIDEBAR_LINKS,
  CONTACT,
  SIDEBAR,
} from '../data/site';
---

<Layout title={SITE.name}>
  <div class="wrap page">
    <div class="col">
      <header class="intro">
        <Image src={portrait} alt={`Portrait of ${SITE.name}`} width={340} class="portrait" loading="eager" />
        <div class="intro-text">
          <h1>{SITE.name}</h1>
          {SITE.tagline ? <p class="tagline">{SITE.tagline}</p> : <p class="todo">{TODO}</p>}
          {SITE.intro ? <p>{SITE.intro}</p> : <p class="todo">{TODO}</p>}
        </div>
      </header>

      <main class="main">
        <section>
          <h2>Interests:</h2>
          <ul>{INTERESTS.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section>
          <h2>Professional experience (what I'm good at):</h2>
          <ul>{EXPERIENCE.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section>
          <h2>Selected projects:</h2>
          {
            PROJECT_GROUPS.map((group) => (
              <>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((entry) => (
                    <li>
                      <EntryText entry={entry} />
                    </li>
                  ))}
                </ul>
              </>
            ))
          }
        </section>
      </main>
    </div>

    <div class="col">
      <nav class="links" aria-label="CV, publications and contact">
        <ul class="arrows">
          {
            SIDEBAR_LINKS.map((entry) => (
              <li>
                <EntryText entry={entry} />
              </li>
            ))
          }
        </ul>
        <ul class="buttons">
          {
            CONTACT.map((entry) => (
              <li>
                <EntryText entry={entry} />
              </li>
            ))
          }
        </ul>
      </nav>

      <aside class="side">
        {
          SIDEBAR.map((section) => (
            <section>
              <h2>{section.title}</h2>
              <ul>
                {section.items.map((entry) => (
                  <li>
                    <EntryText entry={entry} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </aside>
    </div>
  </div>
</Layout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
  }

  .col,
  .main,
  .side {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  /*
    Phones get one column, and the CV and contact links move up under the
    name instead of landing below every project. The columns dissolve so
    their four blocks can be reordered as siblings.
  */
  @media (max-width: 760px) {
    .page {
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding-top: 32px;
    }

    .col {
      display: contents;
    }

    .intro {
      order: 1;
    }

    .links {
      order: 2;
    }

    .main {
      order: 3;
    }

    .side {
      order: 4;
    }
  }

  .intro {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .portrait {
    flex: none;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    object-fit: cover;
    /* The source is portrait 4:5; this keeps the face, not the jacket, in the circle. */
    object-position: 50% 30%;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tagline {
    font-style: italic;
  }

  @media (max-width: 520px) {
    .intro {
      flex-direction: column;
      gap: 16px;
    }

    .portrait {
      width: 140px;
      height: 140px;
    }
  }

  ul {
    margin: 6px 0 0;
    padding-left: 20px;
  }

  h3 {
    margin: 14px 0 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .arrows,
  .buttons {
    list-style: none;
    padding: 0;
  }

  .arrows {
    margin: 0;
    font-weight: 700;
  }

  .arrows li::before {
    content: '» ';
    color: var(--accent);
  }

  /* :global because the links are rendered by EntryText, outside this
     component's style scope. */
  .arrows :global(a) {
    color: var(--accent);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .buttons :global(a) {
    display: inline-block;
    padding: 5px 14px;
    border: 1.5px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .buttons :global(a:hover) {
    background: var(--accent);
    color: #ffffff;
    text-decoration: none;
  }
</style>
