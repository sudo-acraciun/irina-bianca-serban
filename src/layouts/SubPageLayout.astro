---
import Layout from './Layout.astro';
import { SITE } from '../data/site';

interface Props {
  /** Page heading; also leads the browser title. */
  heading: string;
}

const { heading } = Astro.props;
---

<Layout title={`${heading} | ${SITE.name}`}>
  <main class="wrap sub">
    <p><a href={import.meta.env.BASE_URL}>« {SITE.name}</a></p>
    <h1>{heading}</h1>
    <slot />
  </main>
</Layout>

<style>
  .sub {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
